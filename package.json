{
  "name": "qleaner",
  "description": "A CLI tool for analyzing and identifying unused files, images, imports, and dead code in React, Vue, Nuxt, TypeScript, and JavaScript projects to help optimize bundle size and maintain clean codebases",
  "version": "2.0.0",
  "license": "MIT",
  "main": "dist/command.js",
  "bin": "dist/bin/cli.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/trevismurithi/react-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/trevismurithi/react-cleaner/issues"
  },
  "homepage": "https://github.com/trevismurithi/react-cleaner#readme",
  "keywords": [
    "qleaner",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "cleaner",
    "unused",
    "unused-files",
    "files",
    "images",
    "imports",
    "list",
    "cli",
    "dead-code",
    "dead-code-elimination",
    "code-analysis",
    "static-analysis",
    "unused-assets",
    "unused-code",
    "cleanup",
    "optimization",
    "bundle-size",
    "codebase",
    "refactoring",
    "maintenance",
    "typescript",
    "javascript",
    "jsx",
    "tsx",
    "ast",
    "babel",
    "dependency-analysis",
    "code-audit",
    "file-scanner",
    "asset-cleaner",
    "react-cleanup",
    "code-cleaner",
    "unused-imports",
    "orphaned-files",
    "github-action"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node ./dist/bin/cli.js",
    "dev": "tsx ./bin/cli.ts",
    "resolve": "node ./dist/utils/resolver.js",
    "eval:entries": "tsx scripts/eval-entry-points.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^25.2.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@swc/core": "^1.15.46",
    "@vue/compiler-sfc": "^3.5.32",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "enhanced-resolve": "^5.18.3",
    "fast-glob": "^3.3.3",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3"
  }
}
